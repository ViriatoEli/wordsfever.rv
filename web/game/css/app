/* ═══════════════════════════════════════
   WORDS FEVER · app.css
   Game Application Styles
═══════════════════════════════════════ */

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --fire:    #FF4D1C;
  --fire2:   #FF8C42;
  --gold:    #FFDB58;
  --bg:      #07070E;
  --bg2:     #0D0D1A;
  --bg3:     #131323;
  --surface: #1A1A2E;
  --text:    #FFFFFF;
  --text2:   #B8B8CC;
  --muted:   #5E5E78;
  --border:  rgba(255,255,255,0.06);
  --c1: #FF4D1C; --c2: #FF1C4D; --c3: #7C1CFF; --c4: #1CBBFF; --c5: #FFB800; --c6: #00C896;
  --fd: 'Bebas Neue', sans-serif;
  --fb: 'Nunito', sans-serif;
  
  --nav-h: 64px;
}

html, body {
  width: 100%; height: 100%;
  overflow: hidden; /* App feel, no scrolling on body */
  background: var(--bg);
  color: var(--text);
  font-family: var(--fb);
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent; /* Remove blue tap highlight on mobile */
  user-select: none; /* Prevent text selection */
}

/* Noise overlay matching website */
.noise-overlay {
  position: fixed; inset: 0; pointer-events: none; z-index: 9999;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
  opacity: 0.5;
}

#app {
  width: 100%; height: 100%;
  position: relative;
}

.screen {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  display: flex; flex-direction: column;
  background: var(--bg);
  opacity: 0; pointer-events: none;
  transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  transform: translateY(20px);
}
.screen.active {
  opacity: 1; pointer-events: auto;
  transform: translateY(0);
  z-index: 10;
}
.screen.slide-out {
  transform: translateX(-100%);
}
.screen.slide-in-right {
  transform: translateX(100%);
}

.flex-center {
  display: flex; align-items: center; justify-content: center; flex-direction: column;
}

/* Typography utilities */
.grad {
  background: linear-gradient(135deg, var(--fire), var(--fire2) 55%, var(--gold));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.text2 { color: var(--text2); }
.muted { color: var(--muted); }

/* Buttons */
button { font-family: inherit; border: none; outline: none; cursor: pointer; background: none; color: inherit; }
.btn-primary {
  width: 100%; padding: 18px; border-radius: 16px;
  background: linear-gradient(135deg, var(--fire), var(--fire2));
  color: #fff; font-weight: 800; font-size: 1.1rem; letter-spacing: 0.05em;
  box-shadow: 0 8px 24px rgba(255, 77, 28, 0.3);
  transition: transform 0.1s, filter 0.2s;
  text-transform: uppercase;
}
.btn-primary:active { transform: scale(0.97); filter: brightness(1.1); }

.bottom-action {
  padding: 20px;
  background: linear-gradient(to top, var(--bg) 60%, transparent);
  position: absolute; bottom: 0; left: 0; width: 100%;
}

/* Header */
.app-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24px 24px 10px;
}
.app-title { font-family: var(--fd); font-size: 1.5rem; letter-spacing: 0.05em; color: var(--fire); }
.app-version { font-size: 0.75rem; font-weight: 700; color: var(--fire2); background: rgba(255,77,28,0.1); padding: 4px 8px; border-radius: 12px; }
.back-header { justify-content: flex-start; gap: 16px; }
.btn-icon { width: 40px; height: 40px; border-radius: 12px; background: var(--bg2); border: 1px solid var(--border); font-size: 1.2rem; display:flex; align-items:center; justify-content:center; }
.btn-icon:active { background: var(--surface); }
.header-title { font-size: 1.2rem; font-weight: 800; }

/* Splash Screen */
.splash-logo { text-align: center; animation: pulse 2s infinite alternate; }
.splash-icon { font-size: 4rem; margin-bottom: 10px; }
.splash-text { font-family: var(--fd); font-size: 3rem; letter-spacing: 0.05em; }
.splash-text span { color: var(--fire); }
@keyframes pulse { 0% { transform: scale(0.95); } 100% { transform: scale(1.05); } }

/* Home Screen */
.home-hero { padding: 10px 24px 20px; }
.hero-title { font-family: var(--fd); font-size: 3.5rem; line-height: 0.9; margin-bottom: 8px; }
.hero-sub { font-size: 0.9rem; color: var(--text2); }

.mode-list {
  flex: 1; padding: 0 24px 30px;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  display: flex; flex-direction: column; gap: 14px;
}

/* Mode Card */
.mode-card {
  display: flex; background: var(--bg2); border: 1px solid var(--border);
  border-radius: 20px; overflow: hidden; position: relative;
  transition: transform 0.1s, background 0.2s;
}
.mode-card:active { transform: scale(0.97); background: var(--bg3); }
.mode-stripe { width: 4px; }
.mode-card-inner { padding: 16px; display: flex; align-items: center; gap: 16px; flex: 1; }
.mode-emoji { width: 54px; height: 54px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; }
.mode-text { flex: 1; }
.mode-title { font-weight: 900; font-size: 0.85rem; letter-spacing: 0.05em; margin-bottom: 2px; text-transform: uppercase; }
.mode-sub { font-size: 0.7rem; font-weight: 700; margin-bottom: 4px; }
.mode-desc { font-size: 0.75rem; color: var(--text2); line-height: 1.4; }

/* Setup Screen */
.setup-content { padding: 20px 24px; flex: 1; overflow-y: auto; }
.setup-group { margin-bottom: 24px; }
.setup-label { font-size: 0.8rem; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px; }
.setup-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.setup-opt { 
  background: var(--bg2); border: 1px solid var(--border); border-radius: 12px; 
  padding: 14px; text-align: center; font-weight: 700; font-size: 0.9rem; transition: 0.2s;
}
.setup-opt.active { background: rgba(255,77,28,0.1); border-color: var(--fire); color: var(--fire); }

/* Game Screens Common */
.game-header { display: flex; justify-content: space-between; padding: 20px; align-items: center; }
.game-score { font-family: var(--fd); font-size: 1.8rem; color: var(--gold); }
.game-timer { font-family: var(--fd); font-size: 2rem; }
.timer-warn { color: var(--fire); animation: blink 1s infinite; }
@keyframes blink { 50% { opacity: 0.5; } }

/* Indovina / Spiega / Chi Sono */
.card-play { 
  margin: 20px; flex: 1; background: var(--bg2); border: 2px solid var(--border); 
  border-radius: 24px; display: flex; align-items: center; justify-content: center; flex-direction: column;
  transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  padding: 20px; text-align: center;
}
.card-word { font-family: var(--fd); font-size: 4rem; letter-spacing: 0.05em; margin-bottom: 10px; line-height: 1; word-break: break-word; }
.card-desc { font-size: 1rem; color: var(--text2); }

/* Tilt indicators for Indovina mode */
.tilt-overlay { position: absolute; inset: 0; pointer-events: none; opacity: 0; display: flex; align-items: center; justify-content: center; font-size: 6rem; font-family: var(--fd); transition: opacity 0.2s; z-index: 20; }
.tilt-up { background: rgba(52,211,153,0.9); color: #fff; }
.tilt-down { background: rgba(255,77,28,0.9); color: #fff; }
.show-tilt { opacity: 1; }

/* Bomb Word */
.bomb-visual { width: 200px; height: 200px; border-radius: 50%; background: radial-gradient(circle, var(--fire), var(--fire2)); display: flex; align-items: center; justify-content: center; font-size: 5rem; margin: 0 auto; box-shadow: 0 0 40px rgba(255,77,28,0.5); animation: throb 1s infinite alternate; }
@keyframes throb { 0% { transform: scale(1); box-shadow: 0 0 20px rgba(255,77,28,0.4); } 100% { transform: scale(1.05); box-shadow: 0 0 60px rgba(255,77,28,0.8); } }
.bomb-fast { animation: throb 0.3s infinite alternate; background: radial-gradient(circle, #FF1C4D, #FF4D1C); }

/* Results */
.res-title { font-family: var(--fd); font-size: 3rem; margin-bottom: 10px; }
.res-score { font-family: var(--fd); font-size: 5rem; color: var(--fire); line-height: 1; margin-bottom: 20px; }
.res-stats { font-size: 1.1rem; color: var(--text2); }

/* Beat Dash additions */
.setup-input {
  width: 100%;
  background: var(--bg3);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 14px;
  border-radius: 12px;
  font-family: var(--fb);
  font-size: 1rem;
  margin-bottom: 15px;
  outline: none;
  transition: border-color 0.2s;
}
.setup-input:focus {
  border-color: var(--gold);
}
.beatdash-answers {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  width: 100%;
  margin-top: 20px;
}
.bd-ans-btn {
  background: var(--bg2);
  border: 2px solid var(--border);
  color: var(--text);
  border-radius: 12px;
  padding: 16px;
  font-size: 0.85rem;
  font-weight: 700;
  text-align: center;
  transition: all 0.2s;
}
.bd-ans-btn:active {
  transform: scale(0.95);
}
.bd-ans-btn.correct {
  background: rgba(52, 211, 153, 0.15);
  border-color: #34D399;
  color: #34D399;
}
.bd-ans-btn.wrong {
  background: rgba(255, 28, 77, 0.15);
  border-color: #FF1C4D;
  color: #FF1C4D;
}
.bd-progress {
  font-size: 0.8rem;
  color: var(--muted);
  font-weight: 800;
  margin-bottom: 10px;
}

